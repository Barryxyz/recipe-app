// Dev environment. The Supabase URL and publishable key are public by design
// (row-level security protects the data), so they are committed.
// Never put a secret or service_role key here: this repo is public.
// In the prototype, Dev and Prod point at the same hosted project.
//
// "//" starts a comment in xcconfig files, so the URL is written as https:/$()/...

SUPABASE_URL = https:/$()/nvfsptuwvpnlkiqulams.supabase.co
SUPABASE_KEY = sb_publishable_v6HMeB4A7ls8SXTgWSUkSA_ds71bCPn

// Shared recipe links (F4.1 / F4.2): the Cloudflare Worker in share/.
SHARE_BASE_URL = https:/$()/fridge-share.workers.dev
